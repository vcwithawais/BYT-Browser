{
  "name": "secure-browser",
  "version": "1.0.0",
  "description": "A custom, highly secure stateless web browser with Tor support",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "electron:dev": "concurrently \"vite --host 0.0.0.0 --port 3000\" \"wait-on http://localhost:3000 && electron .\"",
    "electron": "electron .",
    "build": "vite build"
  },
  "dependencies": {},
  "devDependencies": {
    "vite": "^6.1.0",
    "electron": "^33.0.0",
    "concurrently": "^9.0.0",
    "wait-on": "^8.0.0"
  }
}
